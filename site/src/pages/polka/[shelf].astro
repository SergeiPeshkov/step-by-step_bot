---
// Страница полки (FR-L09) с фильтром «для кого» (FR-L10).
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import AudienceFilter from "../../components/AudienceFilter.astro";
import { onShelf, usedShelves } from "../../lib/articles";

export function getStaticPaths() {
  return usedShelves().map((s) => ({ params: { shelf: s.id }, props: { s } }));
}
const { s } = Astro.props;
const items = onShelf(s.id).filter((a) => !a.replacedBy);
const base = import.meta.env.BASE_URL;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: s.title,
    itemListElement: items.map((a, i) => ({ "@type": "ListItem", position: i + 1, url: new URL(`${a.slug}/`, Astro.site).href, name: a.title })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Главная", item: Astro.site?.href },
      { "@type": "ListItem", position: 2, name: "Полки", item: new URL("polka/", Astro.site).href },
      { "@type": "ListItem", position: 3, name: s.title, item: new URL(`polka/${s.id}/`, Astro.site).href },
    ],
  },
];
---
<Base title={s.title} description={`${s.title}: ${s.hint}. Короткие ролики и объяснения простыми словами, цифры со ссылками на источники.`} jsonLd={jsonLd}>
  <div class="crumbs"><a href={base}>Главная</a> › <a href={`${base}polka/`}>Полки</a></div>
  <h1>{s.title}</h1>
  <p class="note">{s.hint}</p>
  <section>
    <AudienceFilter />
    {items.length ? <div class="cards">{items.map((a) => <Card a={a} showShelf={false} />)}</div> : <p class="empty">На этой полке пока пусто. Ролики уже в работе.</p>}
  </section>
</Base>
