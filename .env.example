# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CHANNEL_ID=

# Текст (OpenAI-совместимый шлюз: OpenRouter, GigaChat-прокси, локальная модель)
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ИИ-сценарист: обсуждение ролика, сценарий, раскадровка и промпты.
# Можно подключить отдельную, более сильную модель. Пустые поля берутся из LLM_*.
WRITER_PROVIDER=
WRITER_API_KEY=
WRITER_BASE_URL=
WRITER_MODEL=
WRITER_TEMPERATURE=0.8

# Картинки
IMAGE_PROVIDER=stub
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=cheap
IMAGE_QUALITY_MODEL=quality

# Видео
VIDEO_PROVIDER=stub
VIDEO_API_KEY=
VIDEO_BASE_URL=
VIDEO_MODEL=kling-turbo

# Озвучка
TTS_PROVIDER=stub
TTS_API_KEY=
TTS_VOICE=filipp
YANDEX_FOLDER_ID=

# Публикация
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
# YouTube Shorts: Client ID и Secret из Google Cloud Console (тип «Desktop app»),
# refresh token выдаёт скрипт: python scripts/youtube_auth.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public

# Одноклассники: приложение на ok.ru/devaccess, права VIDEO_CONTENT, VALUABLE_ACCESS, GROUP_CONTENT
OK_APP_KEY=
OK_APP_SECRET=
OK_ACCESS_TOKEN=
OK_GROUP_ID=

# Instagram Reels: аккаунт «Автор» или «Бизнес», связанный со страницей Facebook, и приложение Meta
# с правом instagram_content_publish. Без токена можно INSTAGRAM_MANUAL=true — бот пришлёт файл и текст
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_MANUAL=false

# Дзен: открытого API нет. true — бот присылает вам файл и текст для загрузки в Дзен Студии
DZEN_MANUAL=false

# Ссылка на сайт в конце ролика и в описании. Пока сайта нет — оставьте пустым
# Фирменная концовка: положите файл data/brand/outro.mp4 (9:16, 2–3 с) — бот добавит его в конец ролика.
# Другой путь можно задать строкой OUTRO_PATH=...
SITE_URL=
SITE_CARD_TEXT=Подробнее — на сайте
SITE_CARD_SECONDS=2.5
HASHTAGS=#пополочкам

# Сайт (папка site). Нужен Node.js 22. Команда /site собирает сайт из статей в site/dist.
# SITE_DEPLOY_CMD — чем выложить готовую папку на хостинг; путь к ней в переменной SITE_DIST.
# Примеры: rsync -az --delete "$SITE_DIST/" user@host:/var/www/popolochkam/
#          scp -r "%SITE_DIST%\*" user@host:/var/www/popolochkam/   (Windows)
# Пусто — бот только соберёт сайт, загрузите dist сами.
SITE_DEPLOY_CMD=
# true — пересобирать и выкладывать сайт после каждой новой статьи
SITE_AUTO_BUILD=false

# Лимиты, ₽
DAILY_COST_LIMIT=500
MONTHLY_COST_LIMIT=6000
KEEP_FILES_DAYS=30
